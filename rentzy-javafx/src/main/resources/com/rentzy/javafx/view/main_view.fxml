<?xml version="1.0" encoding="UTF-8"?>

import javafx.geometry.Insets?>
import javafx.scene.control.Button?>
import javafx.scene.control.Label?>
import javafx.scene.layout.BorderPane?>
import javafx.scene.layout.HBox?>
import javafx.scene.layout.StackPane?>
import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rentzy.javafx.controller.MainController"
            prefWidth="1200" prefHeight="750">

    <!-- LEFT SIDEBAR NAVIGATION -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240">
            <Label text="⚡ RENTZY" styleClass="brand-title"/>
            <Label text="DESKTOP CONSOLE" styleClass="brand-subtitle"/>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Button fx:id="btnMarketplace" text="🏠  Marketplace Grid" styleClass="nav-button, nav-button-active"
                        maxWidth="Infinity" onAction="#showMarketplace"/>
                <Button fx:id="btnDashboard" text="📊  Analytics Dashboard" styleClass="nav-button"
                        maxWidth="Infinity" onAction="#showDashboard"/>
            </VBox>

            <!-- SERVER SWITCHER FOOTER -->
            <VBox spacing="8" style="-fx-border-color: #334155 transparent transparent transparent; -fx-padding: 16 0 0 0;">
                <Label text="CONNECTION MODE" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                <HBox spacing="6">
                    <Button fx:id="btnLocalApi" text="💻 Localhost" styleClass="btn-secondary"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#switchToLocalApi"/>
                    <Button fx:id="btnCloudApi" text="☁️ Render Cloud" styleClass="btn-primary"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#switchToCloudApi"/>
                </HBox>
                <Label fx:id="lblServerStatus" text="🟢 Connected to Local Backend" style="-fx-font-size: 11px; -fx-text-fill: #34d399;"/>
            </VBox>
        </VBox>
    </left>

    <!-- CENTER DYNAMIC CONTENT AREA -->
    <center>
        <StackPane fx:id="contentContainer" styleClass="content-area">
            <!-- Child views (Marketplace / Dashboard) will be injected here dynamically -->
        </StackPane>
    </center>

</BorderPane>
